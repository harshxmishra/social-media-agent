# LangGraph Social Media Agent - Environment Variables Example
# Copy this file to .env and fill in your actual values.

# --- Core LLM Configuration (Required for content generation) ---
# Choose one or configure your agent to select. Anthropic is default in current nodes.
ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."

# --- Web Scraping (Required for fetching URL content) ---
FIRECRAWL_API_KEY="fc-..."

# --- ArcadeAuth Configuration (Optional, for social media auth) ---
# Set to "true" to enable Arcade for social media authorization, "false" to use basic token auth.
USE_ARCADE_AUTH="false"
ARCADE_API_KEY="arc_..." # Required if USE_ARCADE_AUTH=true

# --- Social Media Intent & Arcade User IDs ---
# These indicate user's intent to use a platform and are used by Arcade.
# For Arcade, these are your application's internal identifiers for the user on these platforms.
# For Basic Auth, they mainly signal intent if the corresponding tokens below are also set.
LINKEDIN_USER_ID="your_app_linkedin_user_id_or_email" # e.g., user's email or a UUID
TWITTER_USER_ID="your_app_twitter_user_id_or_handle"  # e.g., user's email or a UUID for Arcade, or Twitter handle for context

# --- Twitter API Credentials (Required if USE_ARCADE_AUTH=false and using Twitter) ---
# Create a Twitter App at https://developer.twitter.com/
# Ensure your app has "Read and Write" permissions. For v2 posting, Elevated access might be needed.
TWITTER_API_KEY="YOUR_TWITTER_CONSUMER_KEY"
TWITTER_API_KEY_SECRET="YOUR_TWITTER_CONSUMER_SECRET"
TWITTER_BEARER_TOKEN="YOUR_TWITTER_BEARER_TOKEN" # For API v2, can often be generated from Key/Secret
# User Context Tokens (OAuth 1.0a - for posting as a user)
TWITTER_USER_TOKEN="USER_SPECIFIC_ACCESS_TOKEN"
TWITTER_USER_TOKEN_SECRET="USER_SPECIFIC_ACCESS_TOKEN_SECRET"

# --- LinkedIn API Credentials (Required if USE_ARCADE_AUTH=false and using LinkedIn) ---
# Create a LinkedIn App at https://developer.linkedin.com/
# Ensure your app has products like "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_APP_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_APP_CLIENT_SECRET"
# User's Access Token (OAuth 2.0) - obtained via OAuth flow
LINKEDIN_ACCESS_TOKEN="USER_LINKEDIN_OAUTH2_ACCESS_TOKEN"
LINKEDIN_PERSON_URN="urn:li:person:YOUR_LINKEDIN_PERSON_ID" # User's URN, e.g., from /me or OpenID userinfo
# Optional: For posting to a LinkedIn Organization page
POST_TO_LINKEDIN_ORGANIZATION="false" # Set to "true" to enable
LINKEDIN_ORGANIZATION_ID="YOUR_LINKEDIN_ORGANIZATION_ID_OR_URN" # e.g., 12345678 or urn:li:organization:12345678

# --- Supabase Configuration (Optional, for image storage if image features are fully implemented) ---
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # Or anon key if only public buckets are used by client

# --- GitHub API Token (Optional, if GitHub verification node is fully implemented) ---
GITHUB_TOKEN="ghp_..." # Personal Access Token with repo read access

# --- Slack Configuration (Optional, if Slack client/integration is used) ---
SLACK_BOT_TOKEN="xoxb-..." # Bot User OAuth Token
SLACK_TEST_CHANNEL_ID="C0..." # A channel ID for testing message posting

# --- Agent Behavior Configuration (Optional) ---
# TEXT_ONLY_MODE="false" # Set to "true" to skip image processing and YouTube specific handling. Default is false.
# PORT="8000" # Default port if any local server components were run (not primary for Streamlit app)
# LANGSMITH_API_KEY="" # For LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2="true" # To enable LangSmith tracing
# LANGCHAIN_PROJECT="Social Media Agent PY" # LangSmith project name
# SKIP_CONTENT_RELEVANCY_CHECK="false" # Set to "true" to bypass content relevancy LLM checks
# SKIP_USED_URLS_CHECK="false" # Set to "true" to bypass checking/saving previously used URLs
